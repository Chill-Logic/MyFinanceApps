# Normaliza fim de linha: LF no repositorio e tambem no working tree, em qualquer
# sistema (Windows, WSL, macOS, CI). Evita o churn de CRLF quando o mesmo checkout
# e editado ora pelo Windows, ora pelo WSL.
* text=auto eol=lf

# Binarios: nunca normalizar nem tentar diff de texto.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.woff  binary
*.woff2 binary
*.keystore binary
*.jks      binary
